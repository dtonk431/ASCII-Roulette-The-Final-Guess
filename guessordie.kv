#:kivy 2.3.1

# Define base styles
<Label>:
    font_size: '18sp'
    halign: 'center'
    valign: 'middle'

<Button>:
    font_size: '20sp'
    size_hint_y: None
    height: '48dp'

<GameManager>:
    TitleScreen:
        name: 'title'
    GuessingScreen:
        name: 'guessing'
    RouletteScreen:
        name: 'roulette'
    DoorScreen:
        name: 'door'
    ResultScreen:
        name: 'result'

<TitleScreen>:
    canvas.before:
        Color:
            rgba: 0.1, 0.1, 0.1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        padding: 10
        spacing: 20
        Label:
            text: 'Guess the Number\\nor...\\nELSE!'
            font_size: '48sp'
            bold: True
        Label:
            text: 'A Game of Chance and Poor Life Choices'
        Button:
            text: 'Start Game'
            on_press: root.manager.start_new_game()

<GuessingScreen>:
    canvas.before:
        Color:
            rgba: 0.1, 0.2, 0.3, 1
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        padding: 50
        spacing: 20
        Label:
            id: message_label
            text: root.message
            font_size: '20sp'
        TextInput:
            id: guess_input
            multiline: False
            font_size: '48sp'
            size_hint_y: None
            height: '80dp'
            halign: 'center'
            input_filter: 'int'
        Button:
            text: 'Submit Guess'
            font_size: '24sp'
            on_press: root.manager.check_guess(guess_input.text)

<RouletteScreen>:
    canvas.before:
        Color:
            rgba: 0.4, 0.1, 0.1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        padding: 10
        spacing: 10
        Label:
            text: root.manager.current_character.name if root.manager.current_character else ''
            font_size: '24sp'
            size_hint_y: 0.1
            bold: True
        Label:
            text: root.manager.current_character.art if root.manager.current_character else ''
            font_name: 'DroidSansMono'
            font_size: '12sp'
        Label:
            text: root.manager.current_character.intro_dialogue if root.manager.current_character else ''
            text_size: self.width - 20, None
            size_hint_y: 0.2
        Label:
            id: outcome_label
            text: root.outcome_text
            font_size: '22sp'
            bold: True
            color: 1, 1, 0, 1
            size_hint_y: 0.1
        Button:
            id: consequence_button
            text: 'Face the Consequences'
            size_hint_y: 0.1
            on_press:
                root.manager.play_roulette()
                self.disabled = True
            on_release:
                Clock.schedule_once(lambda dt: setattr(self, 'disabled', False), 4)

<DoorScreen>:
    canvas.before:
        Color:
            rgba: 0.1, 0.3, 0.1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        padding: 10
        spacing: 10
        Label:
            text: root.feedback_text
            font_size: '24sp'
            size_hint_y: 0.2
        GridLayout:
            cols: 3
            spacing: 10
            Button:
                text: '[ Door 1 ]'
                font_name: 'DroidSansMono'
                font_size: '32sp'
                on_press: root.manager.play_door_game(1)
            Button:
                text: '[ Door 2 ]'
                font_name: 'DroidSansMono'
                font_size: '32sp'
                on_press: root.manager.play_door_game(2)
            Button:
                text: '[ Door 3 ]'
                font_name: 'DroidSansMono'
                font_size: '32sp'
                on_press: root.manager.play_door_game(3)

<ResultScreen>:
    canvas.before:
        Color:
            rgba: 0.3, 0.3, 0.1, 1
        Rectangle:
            pos: self.pos
            size: self.size
    BoxLayout:
        orientation: 'vertical'
        padding: 10
        spacing: 10
        Label:
            text: root.result_text
            font_size: '28sp'
            text_size: self.width - 20, None
            bold: True
            size_hint_y: 0.3
        Label:
            text: root.art_text
            font_name: 'DroidSansMono'
            font_size: '14sp'
        Button:
            text: 'Play Again'
            on_press: root.manager.current = 'title'
